package live

import (
	"fmt"
	"strings"
)

templ Layout(rootPath string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>fsdiff live - { rootPath }</title>
		<script src="https://unpkg.com/htmx.org@1.9.10"></script>
		<script src="https://unpkg.com/htmx.org@1.9.10/dist/ext/sse.js"></script>
		<style>
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body {
				font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
				background: #0d1117;
				color: #c9d1d9;
				line-height: 1.5;
			}
			.header {
				background: #161b22;
				border-bottom: 1px solid #30363d;
				padding: 1rem 1.5rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				position: sticky;
				top: 0;
				z-index: 100;
			}
			.header h1 {
				font-size: 1.25rem;
				font-weight: 600;
				color: #58a6ff;
			}
			.header .status {
				display: flex;
				align-items: center;
				gap: 1rem;
			}
			.recording-dot {
				width: 10px;
				height: 10px;
				background: #f85149;
				border-radius: 50%;
				animation: pulse 2s infinite;
			}
			@keyframes pulse {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.5; }
			}
			.container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 1.5rem;
			}
			.stats {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1rem;
				margin-bottom: 1.5rem;
			}
			.stat-card {
				background: #161b22;
				border: 1px solid #30363d;
				border-radius: 6px;
				padding: 1rem;
				text-align: center;
			}
			.stat-card .value {
				font-size: 2rem;
				font-weight: 700;
			}
			.stat-card .label {
				font-size: 0.875rem;
				color: #8b949e;
			}
			.stat-card.added .value { color: #3fb950; }
			.stat-card.modified .value { color: #d29922; }
			.stat-card.deleted .value { color: #f85149; }
			.stat-card.total .value { color: #58a6ff; }
			.filter-bar {
				margin-bottom: 1rem;
			}
			.filter-bar input {
				width: 100%;
				padding: 0.75rem 1rem;
				background: #0d1117;
				border: 1px solid #30363d;
				border-radius: 6px;
				color: #c9d1d9;
				font-size: 0.875rem;
				font-family: inherit;
			}
			.filter-bar input:focus {
				outline: none;
				border-color: #58a6ff;
			}
			.timeline {
				background: #161b22;
				border: 1px solid #30363d;
				border-radius: 6px;
				overflow: hidden;
			}
			.change-row {
				display: flex;
				align-items: center;
				padding: 0.75rem 1rem;
				border-bottom: 1px solid #21262d;
				cursor: pointer;
				transition: background 0.15s;
			}
			.change-row:hover {
				background: #1c2128;
			}
			.change-row:last-child {
				border-bottom: none;
			}
			.change-time {
				font-size: 0.75rem;
				color: #8b949e;
				width: 80px;
				flex-shrink: 0;
			}
			.change-icon {
				width: 24px;
				height: 24px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 4px;
				margin-right: 0.75rem;
				font-weight: 700;
				font-size: 0.875rem;
			}
			.change-icon.added { background: rgba(63,185,80,0.2); color: #3fb950; }
			.change-icon.modified { background: rgba(210,153,34,0.2); color: #d29922; }
			.change-icon.deleted { background: rgba(248,81,73,0.2); color: #f85149; }
			.change-path {
				flex: 1;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.change-detail {
				padding: 1rem;
				background: #0d1117;
				border-top: 1px solid #30363d;
				font-size: 0.875rem;
			}
			.change-detail pre {
				background: #161b22;
				padding: 1rem;
				border-radius: 6px;
				overflow-x: auto;
				max-height: 400px;
			}
			.change-detail code {
				color: #c9d1d9;
			}
			.bulk-badge {
				background: #30363d;
				color: #8b949e;
				font-size: 0.75rem;
				padding: 0.25rem 0.5rem;
				border-radius: 10px;
				margin-left: 0.5rem;
			}
			.empty-state {
				text-align: center;
				padding: 3rem;
				color: #8b949e;
			}
			.btn {
				background: #21262d;
				border: 1px solid #30363d;
				color: #c9d1d9;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				cursor: pointer;
				font-family: inherit;
				font-size: 0.875rem;
				text-decoration: none;
				display: inline-block;
			}
			.btn:hover {
				background: #30363d;
			}
		</style>
	</head>
	<body>
		<header class="header">
			<h1>fsdiff live</h1>
			<div class="status">
				<div class="recording-dot"></div>
				<span>Recording: { rootPath }</span>
				<a href="/export" class="btn">Export JSON</a>
			</div>
		</header>
		<main class="container" hx-ext="sse" sse-connect="/events">
			<div class="stats" hx-get="/stats" hx-trigger="load, sse:change" hx-swap="innerHTML">
				@Stats(0, 0, 0, 0)
			</div>
			<div class="filter-bar">
				<input type="text"
					placeholder="Filter changes by path..."
					name="filter"
					hx-get="/changes"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#timeline"
					hx-include="this"/>
			</div>
			<div id="timeline" class="timeline" hx-get="/changes" hx-trigger="load, sse:change">
				@ChangesList([]*Change{}, "")
			</div>
		</main>
	</body>
	</html>
}

templ Stats(total, added, modified, deleted int) {
	<div class="stat-card total">
		<div class="value">{ fmt.Sprint(total) }</div>
		<div class="label">Total</div>
	</div>
	<div class="stat-card added">
		<div class="value">{ fmt.Sprint(added) }</div>
		<div class="label">Added</div>
	</div>
	<div class="stat-card modified">
		<div class="value">{ fmt.Sprint(modified) }</div>
		<div class="label">Modified</div>
	</div>
	<div class="stat-card deleted">
		<div class="value">{ fmt.Sprint(deleted) }</div>
		<div class="label">Deleted</div>
	</div>
}

templ ChangesList(changes []*Change, filter string) {
	if len(changes) == 0 {
		<div class="empty-state">
			<p>No changes detected yet.</p>
			<p>Waiting for filesystem changes...</p>
		</div>
	} else {
		for i, change := range changes {
			if filter == "" || strings.Contains(change.Path, filter) {
				@ChangeRow(change, i)
			}
		}
	}
}

templ ChangeRow(change *Change, idx int) {
	<div class="change-row"
		hx-get={ fmt.Sprintf("/changes/%d", idx) }
		hx-target={ fmt.Sprintf("#detail-%d", idx) }
		hx-swap="innerHTML">
		<span class="change-time">{ change.Timestamp.Format("15:04:05") }</span>
		<span class={ "change-icon " + string(change.Type) }>
			if change.Type == ChangeAdded {
				+
			} else if change.Type == ChangeModified {
				~
			} else {
				-
			}
		</span>
		<span class="change-path">{ change.Path }</span>
		if change.BulkID > 0 {
			<span class="bulk-badge">bulk</span>
		}
	</div>
	<div id={ fmt.Sprintf("detail-%d", idx) } class="change-detail" style="display:none;"></div>
}

templ ChangeDetail(change *Change, content string, idx int) {
	<div>
		<p><strong>Path:</strong> { change.Path }</p>
		<p><strong>Type:</strong> { string(change.Type) }</p>
		<p><strong>Size:</strong> { fmt.Sprintf("%d bytes", change.Size) }</p>
		if change.Hash != "" {
			<p><strong>Hash:</strong> { change.Hash }</p>
		}
		if content != "" {
			<p><strong>Content:</strong></p>
			<pre><code>{ content }</code></pre>
		}
	</div>
}
